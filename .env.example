# Скопируйте этот файл в .env и подставьте свои значения: cp .env.example .env

# --- Telegram ---
# Токен из BotFather.
BOT_TOKEN=<токен из BotFather>
# Сбрасывать апдейты, накопившиеся за время простоя бота.
BOT_DROP_PENDING_UPDATES=true

# --- PostgreSQL ---
POSTGRES_DB=caloriebot
POSTGRES_USER=caloriebot
# Обязательное поле: compose не поднимется с пустым паролем.
POSTGRES_PASSWORD=change_me_please
# Порт базы на хосте (нужен только для отладки и подключения из IDE).
POSTGRES_PORT=5432

# --- Приложение ---
# Порт, на котором доступны / и /health.
BOT_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
